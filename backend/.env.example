LLM_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DEBUG_IMAGES=false
OLLAMA_KEEP_ALIVE=30m
PROCESS_WORKERS=4
GEMINI_MAX_CONCURRENCY=3
# Timeout por chamada ao Gemini. Sem ele, uma request pendurada trava o lote.
GEMINI_TIMEOUT_SECONDS=30
# 0 desliga o thinking (ler um ID nao exige raciocinio). Use -1 pra nao mandar o
# campo, se o modelo nao aceitar thinking_budget.
GEMINI_THINKING_BUDGET=0
